<?xml version="1.0" encoding="UTF-8"?>
<neuroml xmlns="http://www.neuroml.org/schema/neuroml2"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.neuroml.org/schema/neuroml2 https://raw.githubusercontent.com/NeuroML/NeuroML2/master/Schemas/NeuroML_v2.3.xsd"
         id="Na_channel">
    
    <ionChannelHH id="Na" species="na" conductance="10 pS">
        
        <notes>Ungated NCA sodium leak current: I_Na = g_Na*(V-E_Na). No gating variables. Maximal conductance density belongs in the cell's channelDensity.</notes>
    
    </ionChannelHH>

</neuroml>
