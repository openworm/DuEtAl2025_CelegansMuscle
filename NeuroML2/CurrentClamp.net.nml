<?xml version="1.0" encoding="UTF-8"?>
<neuroml xmlns="http://www.neuroml.org/schema/neuroml2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.neuroml.org/schema/neuroml2 https://raw.githubusercontent.com/NeuroML/NeuroML2/development/Schemas/NeuroML2/NeuroML_v2.3.xsd"
    id="CurrentClampNet">

    <include href="SingleCompMuscle.cell.nml"/>
    <include href="EGL_19.channel.nml"/>
    <include href="Kr.channel.nml"/>
    <include href="SHK_1.channel.nml"/>
    <include href="Leak.channel.nml"/>
    <include href="SLO_2.channel.nml"/>
    <include href="Na.channel.nml"/>
    <include href="CaPool.nml"/>

    <pulseGenerator id="iclamp_pulse" delay="50ms" duration="200ms" amplitude="30pA"/>

    <network id="CurrentClampNet" type="networkWithTemperature" temperature="20degC">

        <population id="muscle_pop" component="SingleCompMuscleCell" size="1" type="populationList">
            <instance id="0">
                <location x="0." y="0." z="0."/>
            </instance>
        </population>

        <inputList id="iclamp_input" component="iclamp_pulse" population="muscle_pop">
            <input id="0" target="../muscle_pop/0/SingleCompMuscleCell" destination="synapses"/>
        </inputList>

    </network>

</neuroml>